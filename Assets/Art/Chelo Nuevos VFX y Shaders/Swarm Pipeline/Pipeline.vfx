  m_Name: VFXUI
  m_EditorClassIdentifier: 
  groupInfos: []
  stickyNoteInfos:
  - title: Title
    position:
      serializedVersion: 2
      x: 424
      y: -329
      width: 297
      height: 230
    contents: "UINT: guarda valores sin signo, son no negativos, osea 0 o positivos\n\nParticleID:
      cada particula tiene su ID, lo que hace el nodo es permitirte obtener ese numero
      para cada particula, osea que podes generar variaciones para algunas especificas
      o para todas\n\nStripIndex: particleID te da un identificador \xFAnico para
      cada part\xEDcula, stripIndex te indica a qu\xE9 rastro (o \"strip\") pertenece
      esa part\xEDcula dentro del efecto, osea distinguir entre los diferentes grupos
      o cintas de part\xEDculas, no para identificar individualmente cada part\xEDcula."
    theme: Classic
    textSize: Small
  - title: si es Per Component
    position:
      serializedVersion: 2
      x: 611
      y: 2586
      width: 233
      height: 104
    contents: 'Multiply:

      0 para afectar todo el tentaculo


      0.001-0.002
      por fraccion de tentaculo


'
    theme: Classic
    textSize: Small
  - title: 'ELECTRICIDAD 2 '
    position:
      serializedVersion: 2
      x: 2525
      y: 807
      width: 198
      height: 100
    contents: 'SEPARADA

      AL FINAL PUDE TOMAR LOS VALORES ORIGINALES PARA QUE
      EL RAYO SIGA EL STRIP'
    theme: Classic
    textSize: Small
  - title: Capacity
    position:
      serializedVersion: 2
      x: 791
      y: 239
      width: 126
      height: 100
    contents: '3000

'
    theme: Classic
    textSize: Small
  - title: Title
    position:
      serializedVersion: 2
      x: 1028
      y: 1956
      width: 100
      height: 100
    contents: '0.5

      0

      0.04

'
    theme: Classic
